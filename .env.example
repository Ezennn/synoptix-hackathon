# RegWatch AI — environment template.
# Copy this file to `.env` (same directory) and fill in the values you need.
# `.env` is gitignored, so your real keys are never committed. Values already
# set in your shell environment override this file.
#
#   cp .env.example .env     # then edit .env

# ---- Run mode (Agent A engine) ----------------------------------------------
# stub = offline, deterministic, no key needed (default).
# live = route through LiteLLM to a real model (needs a provider key below).
REGWATCH_LLM_MODE=stub

# Answer model, held constant across all backends. Any LiteLLM-supported id.
# Cheapest Claude: 3.5 Haiku (default below). Even cheaper/older: anthropic/claude-3-haiku-20240307
REGWATCH_MODEL=anthropic/claude-3-5-haiku-latest

# Optional: where the gateway caches responses (default: data/cache).
# REGWATCH_CACHE_DIR=data/cache

# ---- LLM provider key (only needed when REGWATCH_LLM_MODE=live) --------------
# Claude key. LiteLLM reads ANTHROPIC_API_KEY when the model id is anthropic/*.
ANTHROPIC_API_KEY=

# Cost-axis pricing per 1M tokens — must match REGWATCH_MODEL.
# Claude 3.5 Haiku: in 0.80 / out 4.00 (default). Claude 3 Haiku: 0.25 / 1.25.
REGWATCH_PRICE_IN_PER_M=0.80
REGWATCH_PRICE_OUT_PER_M=4.00

# ---- Hosted memory backends (Agent B; only needed for those columns) --------
# Leave blank to run without them — those columns show as 'unavailable',
# the harness does not crash.
ZEP_API_KEY=
LETTA_API_KEY=
